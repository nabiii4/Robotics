{
  "name": "fdrhs-robotics-hub",
  "version": "1.0.0",
  "private": true,
  "description": "FDRHS Robotics Hub \u2014 AI Build Mentor, 3D robot designer, print queue, inventory and VEX Code for the FDRHS Cougars.",
  "scripts": {
    "dev": "npm run db:setup && next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "npm run db:setup && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:setup": "tsx --conditions=react-server scripts/setup.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "seed:a": "cross-env SEED_SCENARIO=A tsx --conditions=react-server scripts/seed.ts --force",
    "seed:b": "cross-env SEED_SCENARIO=B tsx --conditions=react-server scripts/seed.ts --force",
    "reset": "tsx --conditions=react-server scripts/seed.ts --force",
    "backup": "tsx scripts/backup.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.104.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "manifold-3d": "^3.5.4",
    "next": "^15.5.27",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ulid": "^3.0.2",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.186.0",
    "buffer": "^6.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
