# ── AI (SERVER ONLY). Copy to .env and fill in. Never commit .env ──
# Option 1: Azure OpenAI (the club's BSMP resources) — tried first, in this order.
AZURE_OPENAI_ENDPOINT=""                          # https://<your-chapter-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-5.4-nano"            # mentor model (primary)
AZURE_OPENAI_FALLBACK_DEPLOYMENT="gpt-5-nano"     # same resource, fallback model
AZURE_OPENAI_API_VERSION="2025-01-01-preview"

AZURE_OPENAI_BACKUP_ENDPOINT=""
AZURE_OPENAI_BACKUP_API_KEY=""
AZURE_OPENAI_BACKUP_DEPLOYMENT="gpt-5-nano"

AZURE_OPENAI_EMBEDDING_MODEL=""                   # e.g. text-embedding-3-small (optional)
AZURE_OPENAI_EMBEDDING_API_VERSION="2024-10-21"

# Option 2: a regular OpenAI API key (used after the Azure targets, or on its own).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-nano"
OPENAI_EMBEDDING_MODEL=""                         # e.g. text-embedding-3-small (optional)

# ── App ──
APP_URL=""                   # public URL, e.g. https://hub.example.org (auto-detected on Render/Railway; localhost otherwise)
APP_ENCRYPTION_KEY=""        # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TEAM_JOIN_CODE=""            # first join code; blank = generated into data/seed-credentials.txt
ADMIN_USERNAME="coach"
ADMIN_INITIAL_PASSWORD=""    # blank = auto-generate into data/seed-credentials.txt

# ── Database & storage ──
DATABASE_URL="file:./data/fdrhs.db"     # Turso: libsql://<db>-<org>.turso.io
DATABASE_AUTH_TOKEN=""                  # Turso only
UPLOAD_DIR="./data/uploads"

# ── AI limits ──
AI_MAX_REQUESTS_PER_HOUR=40
AI_MAX_REQUESTS_PER_DAY=200
AI_GLOBAL_DAILY_CAP=3000
# AI_MOCK: 1 = always use the built-in demo mentor, 0 = never, auto = demo mentor only when no keys are set
AI_MOCK="auto"

# ── Optional tools ──
GXX_PATH="g++"

# ── Seed ──
SEED_SCENARIO="B"                       # first run only: clean = just your admin + team (use for the real team), B / A = demo data
